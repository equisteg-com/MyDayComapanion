{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pandoc *)",
      "Bash(k6 *)",
      "Bash(maestro *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(npx wrangler dev *)",
      "Bash(npx wrangler d1 * --local*)",
      "Bash(npx playwright *)",
      "Bash(git pull *)",
      "Bash(gitleaks *)",
      "Bash(docker run --rm *)",
      "Bash(python tests/tools/bug_log.py *)",
      "Bash(gh variable list *)",
      "Bash(gh secret list *)",
      "Bash(gh auth status *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh run download *)",
      "Bash(gh workflow run staging-tests.yml *)",
      "Bash(gh workflow run mobile.yml *)",
      "Bash(git branch --show-current*)",
      "Bash(git branch --list*)",
      "Bash(git branch -a*)",
      "Bash(git fetch *)",
      "Bash(git ls-remote *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(rg *)",
      "Bash(python3 tests/tools/bug_log.py *)",
      "Bash(python3 tests/tools/export_cases.py*)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(curl -s https://rdap.org/*)",
      "Bash(curl -I *)",
      "Bash(curl -sI *)",
      "Bash(curl -A * -I *)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s -X * http://localhost:*)",
      "Bash(node --test *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(eas build *)",
      "Bash(eas submit *)",
      "Bash(eas credentials *)",
      "Bash(npx wrangler deploy *)",
      "Bash(npx wrangler secret *)",
      "Bash(npx wrangler d1 migrations apply * --remote*)",
      "Bash(npx wrangler rollback *)",
      "Bash(gh repo edit *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push -f *)",
      "Bash(git push --force *)",
      "Bash(gh pr merge *)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.key)",
      "Bash(git push origin staging*)",
      "Bash(git push origin production*)",
      "Read(./**/.dev.vars)",
      "Read(./**/.dev.vars.*)",
      "Bash(git checkout -b *)",
      "Bash(git checkout -B *)",
      "Bash(git switch *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git push origin --delete *)",
      "Read(./**/.env.*.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./**/*service-account*.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Bash(git credential *)",
      "Bash(gh auth token*)",
      "Bash(printenv*)",
      "Bash(git config core.hooksPath *)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(gh repo edit * --visibility public*)",
      "Bash(gh repo create *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.mjs\""
          }
        ]
      }
    ]
  }
}
